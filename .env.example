# FXR OrderFlow web — Railway service variables. Set them in Railway → Variables, never in the repo.
# Generate random values with:  openssl rand -hex 32

# --- Site
PUBLIC_URL=https://your-domain.example          # https turns on production mode (secure cookies, HSTS, strict checks)
COMPANY_NAME=FXR Fluxora
DISCORD_INVITE=                                  # https://discord.gg/...
SUPPORT_EMAIL=

# --- Secrets
APP_SECRET=                                      # 32+ random chars (openssl rand -hex 32). Do not change it later:
                                                 # it keys the computer fingerprints, changing it unbinds every licence.

# --- Sign in with Discord (discord.com/developers → your app → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# In the Discord portal add exactly this redirect:  <PUBLIC_URL>/api/auth/discord/callback

# --- Owner panel
ADMIN_DISCORD_IDS=                               # your Discord user id (several: comma separated)
ADMIN_PATH=                                      # secret URL of the panel, 16-64 chars a-z 0-9 -, e.g. ops-$(openssl rand -hex 10)
ADMIN_REQUIRE_MFA=true                           # panel refused unless your Discord account has 2FA on (keep true)

# --- Payments (USDT on TRON / TRC20) — PUBLIC receiving address only, NEVER a private key or seed
PAY_ADDRESS=                                     # T... address of a wallet that only you control
ORDER_TTL_HOURS=24                               # time a customer has to pay and paste the transaction id

# --- Optional: external payment provider webhook. Leave EMPTY = endpoint disabled (404).
WEBHOOK_SECRET=

# --- Storage: mount a Railway Volume at /data so data survives redeploys
DATA_DIR=/data
# PORT is provided by Railway automatically.
