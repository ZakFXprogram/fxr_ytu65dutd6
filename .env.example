# FXR OrderFlow web — Railway service variables. Set them in Railway → Variables, never in the repo.
# Generate random values with:  openssl rand -hex 32

# --- Site
PUBLIC_URL=https://your-domain.example          # https turns on production mode (secure cookies, HSTS, strict checks)
COMPANY_NAME=FXR Fluxora
DISCORD_INVITE=                                  # https://discord.gg/... (shown on the site and the dashboard)
SUPPORT_EMAIL=

# --- Secrets
APP_SECRET=                                      # 32+ random chars. Do not change it later: it keys the computer
                                                 # fingerprints, changing it unbinds every licence.

# --- Sign in with Discord (discord.com/developers → your application → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Add exactly this redirect in the Discord portal:  <PUBLIC_URL>/api/auth/discord/callback
# Keep "Public Client" OFF.

# --- Owner panel
ADMIN_DISCORD_IDS=                               # your Discord user id (several: comma separated)
ADMIN_PATH=                                      # secret URL of the panel, 16-64 chars a-z 0-9 -, e.g. ops-<openssl rand -hex 10>
ADMIN_REQUIRE_MFA=true                           # panel refused unless your Discord account has 2FA on (keep true)

# --- Payments: USDT (TRC20) straight to your own wallet. No provider, no fee, no key on the server.
TRON_RECEIVING_ADDRESS=                          # your PUBLIC TRON address ("T...", 34 chars). Never a private key or
                                                 # seed phrase. Empty = checkout closed. The checksum is verified at start.
TRONGRID_API_KEY=                                # optional but recommended: free key from trongrid.io (higher rate limits).
                                                 # Read-only: it can only read public blockchain data.
PAYMENT_WINDOW_MINUTES=30                        # time a buyer has to send the exact amount (10-240)
# Advanced, rarely needed:
# TRON_API_BASE=https://api.trongrid.io          # index that lists incoming USDT transfers
# TRON_NODE_URL=https://api.trongrid.io          # node that re-checks every transaction; point it at another provider
# TRON_NODE_API_KEY=                             # ...and its key, for a second, independent source

# --- Discord member role (optional: the site adds/removes it with your bot)
DISCORD_BOT_TOKEN=                               # bot needs "Manage Roles"; its role must sit ABOVE the member role
DISCORD_GUILD_ID=                                # your server id
DISCORD_MEMBER_ROLE_ID=                          # the role that opens the members' / install channel

# --- Storage: mount a Railway Volume at /data so data survives redeploys
DATA_DIR=/data
# PORT is provided by Railway automatically.
