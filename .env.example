# FXR OrderFlow web — Railway service variables (set these in Railway, not in the repo).
# Generate secrets with:  openssl rand -base64 24

PUBLIC_URL=https://fxr-xxxx.up.railway.app   # turns on production checks
ADMIN_USER=admin
ADMIN_PASSWORD=                              # 10+ chars, for the /admin dashboard
WEBHOOK_SECRET=                              # 16+ chars, shared with the payment provider

# Storage (mount a Railway Volume here so licences survive redeploys)
DATA_DIR=/data

# Site details
COMPANY_NAME=FXR Fluxora
DISCORD_INVITE=                              # https://discord.gg/...
SUPPORT_EMAIL=

# Checkout links from your crypto payment provider (NOWPayments, BTCPay, Coinbase Commerce, ...)
# One link per plan; the Buy buttons use them. Leave blank to show "Buy on Discord".
CHECKOUT_MONTH1=
CHECKOUT_MONTH3=
CHECKOUT_MONTH6=
CHECKOUT_YEAR1=
CHECKOUT_LIFETIME=
# PORT is provided by Railway automatically.
